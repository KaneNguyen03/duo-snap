{
  "name": "duo-snap",
  "private": true,
  "engines": {
    "node": "^22.21.0",
    "pnpm": "^10.19.0"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "turbo run build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "db:push": "turbo -F @duo-snap/db push",
    "db:studio": "turbo -F @duo-snap/db studio",
    "dev": "turbo watch dev --continue",
    "dev:web": "turbo watch dev -F @duo-snap/nextjs...",
    "dev:mobile": "turbo watch dev -F @duo-snap/expo...",
    "format": "turbo run format --continue -- --write --cache --cache-location .cache/.prettiercache",
    "format:check": "turbo run format --continue -- --cache --cache-location .cache/.prettiercache",
    "lint": "turbo run lint --continue -- --cache --cache-location .cache/.eslintcache",
    "lint:fix": "turbo run lint --continue -- --fix --cache --cache-location .cache/.eslintcache",
    "lint:ws": "pnpm dlx sherif@latest",
    "postinstall": "pnpm lint:ws",
    "typecheck": "turbo run typecheck",
    "ui-add": "turbo run ui-add",
    "android": "pnpm -F @duo-snap/expo android",
    "ios": "pnpm -F @duo-snap/expo ios"
  },
  "devDependencies": {
    "@duo-snap/prettier-config": "workspace:*",
    "@turbo/gen": "^2.5.8",
    "dotenv-cli": "^10.0.0",
    "prettier": "catalog:",
    "turbo": "^2.5.8",
    "typescript": "catalog:"
  },
  "prettier": "@duo-snap/prettier-config"
}

